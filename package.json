{
  "name": "isp-visibility-checker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A read-only, privacy-conscious home gateway audit with a CLI and a local dashboard",
  "scripts": {
    "cli:scan": "bun src/apps/cli/scan.ts",
    "cli:watch": "bun src/apps/cli/watch.ts",
    "web:start": "bun src/apps/web/server.ts",
    "web:dev": "bun --watch src/apps/web/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@runonflux/nat-upnp": "2.2.0",
    "systeminformation": "5.33.19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.14.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
